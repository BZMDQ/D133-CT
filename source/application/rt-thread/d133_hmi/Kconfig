config HMI_FW_VERSION
    string "D133-控制终端 firmware semantic version"
    default "1.0.0"

config HMI_APP
    bool
    default y

config HMI_QUIET_CONSOLE
    bool "Silence RT-Thread console in production"
    depends on HMI_APP
    default n

config HMI_DISPLAY_PROFILE_SERIAL
    bool "Enable UART0 panel profile commands"
    depends on HMI_APP && HMI_QUIET_CONSOLE
    select AIC_USING_UART0
    default y

config HMI_SERIAL_DIAGNOSTICS
    bool "Enable HMI serial diagnostics"
    depends on HMI_APP
    default n

config HMI_NETWORK
    bool "Enable D133 toolbox TCP OTA server"
    default n
config HMI_UI
    bool "Enable D133-控制终端 application UI"
    default n
    select LPKG_USING_FREETYPE
config HMI_SD_OTA
    bool "Enable SD OTA shell entry"
    default n


