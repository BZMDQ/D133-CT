+/* 创建 STM32 主菜单风格的应用卡片，整张卡片都可触摸打开。 */
+static lv_obj_t *app_tile(lv_obj_t *parent, const char *symbol,
+                          const char *title, const char *description,
+                          int x, int y, int width, int height,
+                          unsigned target, uint32_t accent)
+{
+    lv_obj_t *tile = lv_button_create(parent);
+    lv_obj_t *icon_tile;
+    lv_obj_t *icon;
+    lv_obj_t *title_label;
+    lv_obj_t *description_label;
+    lv_obj_t *arrow;
+
+    lv_obj_set_pos(tile, x, y);
+    lv_obj_set_size(tile, width, height);
+    lv_obj_set_style_bg_color(tile, lv_color_hex(UI_COLOR_WHITE), LV_PART_MAIN);
+    lv_obj_set_style_bg_color(tile, lv_color_hex(UI_COLOR_SURFACE_ALT),
+                              LV_PART_MAIN | LV_STATE_PRESSED);
+    lv_obj_set_style_bg_opa(tile, LV_OPA_COVER, LV_PART_MAIN);
+    lv_obj_set_style_text_color(tile, lv_color_hex(UI_COLOR_TEXT), LV_PART_MAIN);
+    lv_obj_set_style_border_color(tile, lv_color_hex(UI_COLOR_BORDER), LV_PART_MAIN);
+    lv_obj_set_style_border_width(tile, 1, LV_PART_MAIN);
+    lv_obj_set_style_radius(tile, 12, LV_PART_MAIN);
+    lv_obj_set_style_shadow_width(tile, 0, LV_PART_MAIN);
+    lv_obj_clear_flag(tile, LV_OBJ_FLAG_SCROLLABLE);
+
+    icon_tile = lv_obj_create(tile);
+    lv_obj_set_pos(icon_tile, 18, (height - 64) / 2);
+    lv_obj_set_size(icon_tile, 64, 64);
+    lv_obj_set_style_bg_color(icon_tile, lv_color_hex(accent), LV_PART_MAIN);
+    lv_obj_set_style_bg_opa(icon_tile, LV_OPA_COVER, LV_PART_MAIN);
+    lv_obj_set_style_border_width(icon_tile, 0, LV_PART_MAIN);
+    lv_obj_set_style_radius(icon_tile, 14, LV_PART_MAIN);
+    lv_obj_set_style_pad_all(icon_tile, 0, LV_PART_MAIN);
+    lv_obj_clear_flag(icon_tile, LV_OBJ_FLAG_CLICKABLE | LV_OBJ_FLAG_SCROLLABLE);
+
+    icon = lv_label_create(icon_tile);
+    lv_label_set_text(icon, symbol);
+    lv_obj_set_style_text_font(icon, &lv_font_montserrat_16, LV_PART_MAIN);
+    lv_obj_set_style_text_color(icon, lv_color_hex(UI_COLOR_WHITE), LV_PART_MAIN);
+    lv_obj_center(icon);
+
+    title_label = lv_label_create(tile);
+    lv_label_set_text(title_label, title);
+    lv_obj_set_pos(title_label, 98, 34);
+    lv_obj_set_width(title_label, width - 142);
+    lv_obj_set_style_text_font(title_label, body_font(), LV_PART_MAIN);
+    lv_obj_set_style_text_color(title_label, lv_color_hex(UI_COLOR_TEXT), LV_PART_MAIN);
+
+    description_label = lv_label_create(tile);
+    lv_label_set_text(description_label, description);
+    lv_obj_set_pos(description_label, 98, 70);
+    lv_obj_set_width(description_label, width - 140);
+    lv_label_set_long_mode(description_label, LV_LABEL_LONG_DOT);
+    lv_obj_set_style_text_font(description_label, small_font(), LV_PART_MAIN);
+    lv_obj_set_style_text_color(description_label, lv_color_hex(UI_COLOR_MUTED), LV_PART_MAIN);
+
+    arrow = lv_label_create(tile);
+    lv_label_set_text(arrow, LV_SYMBOL_RIGHT);
+    lv_obj_set_pos(arrow, width - 34, (height - 20) / 2);
+    lv_obj_set_style_text_font(arrow, &lv_font_montserrat_16, LV_PART_MAIN);
+    lv_obj_set_style_text_color(arrow, lv_color_hex(UI_COLOR_MUTED), LV_PART_MAIN);
+
+    lv_obj_add_event_cb(tile, navigation, LV_EVENT_CLICKED,
+                        (void *)(uintptr_t)target);
+    return tile;
+}
