diff --git a/source/application/rt-thread/d133_hmi/ui/image_preview.c b/source/application/rt-thread/d133_hmi/ui/image_preview.c
index e779395..a87664d 100644
--- a/source/application/rt-thread/d133_hmi/ui/image_preview.c
+++ b/source/application/rt-thread/d133_hmi/ui/image_preview.c
@@ -355,0 +356,24 @@ static int decode_bmp_preview(const char *path, uint64_t file_size)
+        /* 常见 BGR24/BGRX32 不走通用格式分派与逐像素 memcpy。 */
+        if (bits_per_pixel == 24 ||
+            (bits_per_pixel == 32 &&
+             (compression == 0 ||
+              (red_mask == 0x00FF0000U && green_mask == 0x0000FF00U &&
+               blue_mask == 0x000000FFU)))) {
+            const uint8_t *src = source_row;
+            uint16_t *dst = (uint16_t *)output_row;
+
+            for (x = 0; x < output_width; x++) {
+                uint8_t blue = src[0];
+                uint8_t green = src[1];
+                uint8_t red = src[2];
+                dst[x] = (uint16_t)(((uint16_t)(red & 0xF8U) << 8) |
+                                    ((uint16_t)(green & 0xFCU) << 3) |
+                                    ((uint16_t)blue >> 3));
+                src += bytes_per_pixel;
+            }
+            if (output_stride > output_width * 2U)
+                memset(output_row + output_width * 2U, 0,
+                       output_stride - output_width * 2U);
+            continue;
+        }
+
