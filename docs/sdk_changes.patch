+struct aic_memheap
+{
+    aic_mem_region_t    type;
+    char *              name;
+    void *              begin_addr;
+    void *              end_addr;
+    struct rt_memheap   heap;
+    struct rt_mutex     lock;
+};
+
+struct aic_memheap aic_memheaps[] = {
+#ifdef AIC_TCM_EN
+    {MEM_ITCM, "heap_itcm", (void *)&__itcm_heap_start, (void *)&__itcm_heap_end},
