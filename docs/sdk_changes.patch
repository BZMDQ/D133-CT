+        return;
+    }
+    /* 两种界面字号复用同一个字体实例，避免重复创建 FreeType 字体对象。 */
+    hmi_font_small = hmi_font;
+    rt_kprintf("[boot_time] chinese_font_ready=%u ms\n",app_manager_boot_elapsed_ms());
+    lv_obj_set_style_text_font(root, body_font(), LV_PART_MAIN);
+    if (!app_manager_ready()) {
+        label(root, "应用服务初始化失败，请检查串口日志。", 20, 30, 900);
+        rt_kprintf("[hmi] application services are not ready; health confirmation blocked\n");
+        return;
+    }
+    image_preview_ready = image_preview_init() == 0;
+    if (!image_preview_ready)
+        system_manager_log("图片预览服务初始化失败");
+
+    lv_obj_set_style_bg_color(root, lv_color_hex(0xF3F6FA), LV_PART_MAIN);
+    nav = lv_obj_create(root);
+    lv_obj_set_pos(nav, 0, 0);
+    lv_obj_set_size(nav, 210, 600);
+    lv_obj_set_style_bg_color(nav, lv_color_hex(0xFFFFFF), LV_PART_MAIN);
+    lv_obj_set_style_radius(nav, 0, LV_PART_MAIN);
+    label(nav, "D133CBS\n工业控制终端", 12, 14, 180);
+    for (unsigned i = 0; i < 6; i++)
+        nav_buttons[i] = button(nav, titles[i], 12, 82 + (int)i * 68,
+                                180, navigation, (void *)(uintptr_t)i);
+
+    top = label(root, "系统启动中……", 230, 25, 770);
+    content = lv_obj_create(root);
+    lv_obj_set_pos(content, 225, 75);
+    lv_obj_set_size(content, 784, 510);
+    lv_obj_set_style_bg_color(content, lv_color_hex(0xFFFFFF), LV_PART_MAIN);
+    lv_obj_set_style_radius(content, 16, LV_PART_MAIN);
+    keyboard = lv_keyboard_create(root);
+    lv_obj_set_size(keyboard, 1024, 235);
+    lv_obj_align(keyboard, LV_ALIGN_BOTTOM_MID, 0, 0);
+    lv_obj_add_flag(keyboard, LV_OBJ_FLAG_HIDDEN);
+    lv_obj_add_event_cb(keyboard, keyboard_event, LV_EVENT_ALL, NULL);
+    screen(0);
+    lv_timer_create(timer, 200, NULL);
+    if (lv_display_get_default()) {
+        lv_display_add_event_cb(lv_display_get_default(), boot_display_timing,
+                                LV_EVENT_RENDER_READY, NULL);
+        lv_display_add_event_cb(lv_display_get_default(), boot_display_timing,
+                                LV_EVENT_FLUSH_FINISH, NULL);
+    }
+    rt_kprintf("[boot_time] hmi_widgets_ready=%u ms\n",app_manager_boot_elapsed_ms());
+}
