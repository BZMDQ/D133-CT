+#include "ui_manager.h"
+#include "app_manager.h"
+#include "lvgl.h"
+#include <rtthread.h>
+#include "storage_manager.h"
+#include "sd_manager.h"
+#include "ota_manager.h"
+#include "ota_package.h"
+#include "boot_manager.h"
+#include "network_manager.h"
+#include "system_manager.h"
