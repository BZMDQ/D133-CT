+
+/* 为单次 HMI 图片预览设置 MPP 硬件裁剪窗口，输出尺寸只占可视区域。 */
+int lv_mpp_dec_set_preview_crop(const char *src, const struct mpp_dec_crop_info *crop);
+void lv_mpp_dec_clear_preview_crop(const char *src);
+
+lv_result_t lv_frame_buf_alloc(mpp_decoder_data_t *mpp_data, struct mpp_buf *alloc_buf,
+                              int *size, uint32_t cf);
+
+void lv_frame_buf_free(mpp_decoder_data_t *mpp_data);
