+/* HMI 只给选中的文件设置一次裁剪，避免改动其它 LVGL 图片的解码行为。 */
+int lv_mpp_dec_set_preview_crop(const char *src, const struct mpp_dec_crop_info *crop)
+{
+    size_t path_len;
+
+    if (!src || !crop || !preview_crop_lock_ready)
+        return -1;
+    path_len = strlen(src);
+    if (path_len == 0 || path_len >= sizeof(preview_crop_src) ||
+        crop->crop_x < 0 || crop->crop_y < 0 ||
+        crop->crop_width <= 0 || crop->crop_height <= 0 ||
+        crop->crop_out_x < 0 || crop->crop_out_y < 0)
+        return -2;
+
+    lv_mutex_lock(&preview_crop_lock);
+    memcpy(preview_crop_src, src, path_len + 1);
+    preview_crop_info = *crop;
+    preview_crop_pending = true;
+    lv_mutex_unlock(&preview_crop_lock);
+    return 0;
+}
+
+void lv_mpp_dec_clear_preview_crop(const char *src)
+{
+    if (!src || !preview_crop_lock_ready)
+        return;
+
+    lv_mutex_lock(&preview_crop_lock);
+    if (preview_crop_pending && strcmp(preview_crop_src, src) == 0) {
+        preview_crop_pending = false;
+        preview_crop_src[0] = '\0';
+    }
+    lv_mutex_unlock(&preview_crop_lock);
+}
+
+static bool lv_mpp_dec_take_preview_crop(const char *src,
+                                         struct mpp_dec_crop_info *crop)
+{
+    bool matched = false;
+
+    if (!src || !crop || !preview_crop_lock_ready)
+        return false;
+
+    lv_mutex_lock(&preview_crop_lock);
+    if (preview_crop_pending && strcmp(preview_crop_src, src) == 0) {
+        *crop = preview_crop_info;
+        preview_crop_pending = false;
+        preview_crop_src[0] = '\0';
+        matched = true;
+    }
+    lv_mutex_unlock(&preview_crop_lock);
+    return matched;
+}
