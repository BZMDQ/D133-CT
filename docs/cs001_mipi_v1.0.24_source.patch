+        fw_env_close();

+    }

+

+    /* 在显示驱动 probe 前按实际接口切换 D133 显示引脚复用。 */

+    for (i = 0; i < ARRAY_SIZE(display_pins); i++) {

+        long pin = hal_gpio_name2pin((char *)display_pins[i]);

+        if (pin >= 0)

+            hal_gpio_set_func(GPIO_GROUP(pin), GPIO_GROUP_PIN(pin),

+                              connector == AIC_MIPI_COM ? 4 : 3);

+    }

+

+    return connector;

+}

